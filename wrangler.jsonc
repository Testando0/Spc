{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "redspace",
  "main": "./artifacts/api-server/src/worker.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./artifacts/redspace-web/dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/__worker_health",
      "/register",
      "/login",
      "/messages/*",
      "/groups/*",
      "/stories/*",
      "/friends/*",
      "/uploads/*",
      "/avatars/*",
      "/socket.io/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
